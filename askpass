#!/usr/bin/python3 -I
"""sudo askpass helper: show who wants to run what, and ask before taking a password."""
import html
import os
import pwd
import shlex
import subprocess
import sys
import time

KDIALOG = "/usr/bin/kdialog"
ZENITY = "/usr/bin/zenity"
TIMEOUT = 120          # seconds per dialog, then treated as cancelled
MAX_COMMAND = 2000     # longer commands are blocked: never approve what can't be shown


def visible(text):
    """Escape anything that could hide or reorder text in a dialog or the log."""
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode() for c in text)


def cmdline(pid):
    with open(f"/proc/{pid}/cmdline", "rb") as f:
        raw = f.read()
    return [os.fsdecode(a) for a in raw.rstrip(b"\0").split(b"\0")] if raw else []


def status(pid):
    with open(f"/proc/{pid}/status", errors="replace") as f:
        fields = dict(line.rstrip("\n").split(":\t", 1) for line in f if ":\t" in line)
    return fields["Name"], int(fields["PPid"])


def requesters(sudo_pid):
    """Names of sudo's ancestors, nearest first."""
    names = []
    try:
        pid = status(sudo_pid)[1]
        while pid > 1 and len(names) < 8:
            name, pid = status(pid)
            names.append(visible(name))
    except (OSError, KeyError, ValueError):
        pass
    return names or ["unknown"]


def log(decision, names, command):
    # Not from $HOME: the log location shouldn't depend on the caller's environment.
    directory = os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".local/state/askpass")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(directory, "requests.log"),
                 os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "w") as f:
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
        f.write(f"{stamp}\t{decision}\t{' < '.join(names)}\t{command}\n")


def run(argv):
    """Return the dialog's stdout, or None if declined, closed or timed out."""
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                           stdin=subprocess.DEVNULL, timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        return None
    return p.stdout if p.returncode == 0 else None


def confirm(names, command, cwd):
    who = " < ".join(names)
    if os.access(KDIALOG, os.X_OK):
        # kdialog renders HTML and expands backslashes, so neutralise both.
        esc = lambda s: html.escape(s).replace("\\", "&#92;")
        text = (f"<qt><p>A program wants to run as root:</p><p><b><code>{esc(command)}</code></b></p>"
                f"<p>Asked by: {esc(who)}<br>In: {esc(cwd)}</p></qt>")
        return run([KDIALOG, "--title", "askpass", "--yes-label", "Allow",
                    "--no-label", "Block", "--warningyesno", text]) is not None
    text = f"A program wants to run as root:\n\n{command}\n\nAsked by: {who}\nIn: {cwd}"
    return run([ZENITY, "--question", "--title=askpass", "--icon=dialog-warning",
                "--no-markup", "--default-cancel", "--ok-label=Allow",
                "--cancel-label=Block", f"--text={text}"]) is not None


def ask_password():
    if os.access(KDIALOG, os.X_OK):
        return run([KDIALOG, "--title", "askpass", "--password", "Password for sudo:"])
    return run([ZENITY, "--password", "--title=askpass: password for sudo"])


def main():
    sudo_pid = os.getppid()
    try:
        argv = cmdline(sudo_pid)
    except OSError:
        argv = []
    command = " ".join(shlex.quote(a) for a in argv)
    command = visible(command)
    names = requesters(sudo_pid)
    cwd = visible(os.getcwd())

    def refuse(decision, message=None):
        log(decision, names, command[:MAX_COMMAND])
        if message:
            print(f"askpass: {message}", file=sys.stderr)
        return 1

    if not argv or os.path.basename(argv[0]) != "sudo":
        return refuse("blocked", "not called by sudo, refusing")
    if len(command) > MAX_COMMAND:
        return refuse("blocked", "command is too long to show in full, refusing")
    if not (os.access(KDIALOG, os.X_OK) or os.access(ZENITY, os.X_OK)):
        return refuse("blocked", "install kdialog or zenity")
    if not confirm(names, command, cwd):
        return refuse("blocked", "request was blocked or timed out")
    password = ask_password()
    if password is None:
        return refuse("cancelled", "password dialog was cancelled or timed out")
    if os.getppid() != sudo_pid:
        return refuse("cancelled", "sudo exited while waiting")
    log("allowed", names, command)
    sys.stdout.buffer.write(password.rstrip(b"\n") + b"\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
